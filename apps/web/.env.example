# Server-only target used by the Next.js /v1 reverse proxy.
BACKEND_API_URL=http://127.0.0.1:8080
# Keep long-running task streams and image responses alive for at most 15 minutes.
BACKEND_PROXY_TIMEOUT_MS=900000

# Default tag query shown in the search box when the dashboard loads.
NEXT_PUBLIC_DEFAULT_SEARCH_TAGS=language:chinese female:big breasts
