map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${GATEWAY_LISTEN_PORT};
    server_name _;

    client_max_body_size 100m;

    # Every browser-facing API call stays on the gateway origin. No CORS
    # headers are needed because the upstream address is server-side only.
    location /v1/ {
        proxy_pass ${BACKEND_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;

        # Do not buffer uploads, downloads, images, or SSE progress events.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no always;

        proxy_connect_timeout 5s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        send_timeout 900s;

        proxy_intercept_errors on;
        error_page 502 504 = @backend_unavailable;
    }

    location @backend_unavailable {
        internal;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 502 '{"error":"backend API unavailable; check BACKEND_API_URL and network connectivity"}';
    }

    location / {
        proxy_pass ${FRONTEND_APP_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
