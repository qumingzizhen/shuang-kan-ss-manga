{
  "version": "0.1.0",
  "default_source_id": "fangliding",
  "sources": [
    {
      "id": "fangliding",
      "name": "Fangliding",
      "homepage": "https://ex.fangliding.eu.org/",
      "thumbnail_hosts": ["ehgt.org"],
      "version": "0.4.3",
      "capabilities": ["search", "gallery", "download", "retry_folder", "page_list", "page_image", "online_read"],
      "enabled": true,
      "notes": "Built-in E-Hentai-compatible adapter sharing the validated search, reader, retry, and download core; no project-external script is required.",
      "self_tests": [
        { "script": "scripts/check_fangliding_pagination.py" },
        { "script": "scripts/check_fangliding_reader.py" }
      ],
      "bridge": {
        "kind": "python",
        "script": "scripts/fangliding_bridge.py",
        "script_env": "FANGLIDING_BRIDGE_SCRIPT",
        "python_env": ["FANGLIDING_PYTHON", "MANGA_BRIDGE_PYTHON"],
        "page_commands": true
      }
    },
    {
      "id": "18comic",
      "name": "18comic.vip",
      "homepage": "https://18comic.vip/",
      "thumbnail_hosts": ["18comic.vip", "jmapiproxy1.cc", "jmapiproxy2.cc", "jmapinodeudzn.net"],
      "version": "0.2.0",
      "capabilities": ["search", "gallery", "download", "retry_folder", "page_list", "page_image", "online_read"],
      "enabled": true,
      "notes": "API-first adapter using the official JM mobile API with the public website as a conservative fallback. It stops on login, captcha, ban, or rate-limit boundaries.",
      "self_tests": [
        { "script": "scripts/18comic_bridge.py", "args": ["self-test"] }
      ],
      "auth": {
        "mode": "cookie_headers",
        "cookie_env": "COMIC18_COOKIE_FILE",
        "headers_env": "COMIC18_HEADERS_FILE",
        "file_stem": "18comic",
        "title": "18comic 网页备用会话",
        "description": "移动 API 默认无需配置；仅在网页兼容回退需要登录会话时使用。",
        "headers_placeholder": "User-Agent: ...\nReferer: https://18comic.vip/"
      },
      "bridge": {
        "kind": "python",
        "script": "scripts/18comic_bridge.py",
        "script_env": "COMIC18_BRIDGE_SCRIPT",
        "python_env": ["COMIC18_PYTHON", "MANGA_BRIDGE_PYTHON"],
        "page_commands": true
      }
    },
    {
      "id": "e-hentai",
      "name": "E-Hentai",
      "homepage": "https://e-hentai.org/",
      "thumbnail_hosts": ["e-hentai.org", "ehgt.org"],
      "version": "0.2.0",
      "capabilities": ["search", "gallery", "download", "retry_folder", "page_list", "page_image", "online_read"],
      "enabled": true,
      "notes": "Conservative public-page adapter using scripts/ehentai_bridge.py. It parses search, gallery index pages, and single image pages without bypassing login, captcha, ban, or rate-limit boundaries.",
      "self_tests": [
        { "script": "scripts/ehentai_bridge.py", "args": ["self-test"] }
      ],
      "bridge": {
        "kind": "python",
        "script": "scripts/ehentai_bridge.py",
        "script_env": "EHENTAI_BRIDGE_SCRIPT",
        "python_env": ["EHENTAI_PYTHON", "MANGA_BRIDGE_PYTHON"],
        "page_commands": true
      }
    },
    {
      "id": "exhentai",
      "name": "ExHentai",
      "homepage": "https://exhentai.org/",
      "thumbnail_hosts": ["ehgt.org"],
      "version": "0.1.0",
      "capabilities": ["search", "gallery", "download", "retry_folder", "page_list", "page_image", "online_read"],
      "enabled": true,
      "notes": "E-Hentai-compatible adapter gated by ExHentai membership access control. Anonymous requests are redirected to the login flow, so search, reading, and download only work with the user's own authorized cookie or headers configured locally. The bridge never bypasses login, captcha, ban, or rate-limit boundaries.",
      "self_tests": [
        { "script": "scripts/exhentai_bridge.py", "args": ["self-test"] }
      ],
      "auth": {
        "mode": "cookie_headers",
        "cookie_env": "EXHENTAI_COOKIE_FILE",
        "headers_env": "EXHENTAI_HEADERS_FILE",
        "file_stem": "exhentai",
        "title": "ExHentai 授权会话",
        "description": "ExHentai 需要登录授权。请配置你自己的合法会话 Cookie 或请求头；未配置时搜索/阅读会返回访问受限错误。",
        "headers_placeholder": "User-Agent: ...\nReferer: https://exhentai.org/"
      },
      "bridge": {
        "kind": "python",
        "script": "scripts/exhentai_bridge.py",
        "script_env": "EXHENTAI_BRIDGE_SCRIPT",
        "python_env": ["EXHENTAI_PYTHON", "MANGA_BRIDGE_PYTHON"],
        "page_commands": true
      }
    }
  ]
}